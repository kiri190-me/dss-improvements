{
  "name": "dss-improvements",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --port 3500",
    "build": "next build --webpack",
    "start": "next start --port 3500",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-test-list.mjs unit -- --import tsx --test",
    "db:up": "docker compose --env-file .env.local up -d db-dev",
    "db:down": "docker compose --env-file .env.local down",
    "db:psql": "docker exec -it dss-improvements-postgres-dev psql -U dss_improvements_app -d dss_improvements_dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
