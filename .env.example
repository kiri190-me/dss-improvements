# ------------------------------------------------------------------
# DSS 개선요청 — 환경변수 예시
#
# 이 파일을 복사해서 .env.local 을 만들고 실제 값을 채운다.
#   cp .env.example .env.local
#
# .env.local 은 git 에 올리지 않는다. 비밀번호를 여기에 적지 않는다.
# 이 파일에는 **항목 이름만** 둔다 — 값이 필요한 칸은 비워 둔다.
# ------------------------------------------------------------------

# PostgreSQL 접속 주소
#
# 포트가 5446 인 이유: 이 개발 PC 에서 A/S 가 5432·5433, dss-auth 가 5434,
# 회사 홈페이지가 5436, 계측기의 옛 상자가 5438, 그리고 2026-09-03 부터
# 공용 인스턴스 dss-pg-app 이 5442 · dss-pg-auth 가 5444 를 쓴다.
# docker-compose.yml 의 머리말에 「공용 인스턴스에 DB 를 하나 더 만드는 길」도
# 적어 두었다 — 그쪽을 고르면 이 값도 5442 로 바꾼다.
DATABASE_URL=postgres://dss_improvements_app:CHANGE_ME@127.0.0.1:5446/dss_improvements_dev

# docker-compose.yml 이 읽는 값. 위 DATABASE_URL 의 비밀번호와 같아야 한다.
DEV_POSTGRES_PASSWORD=

# 이 사이트가 쓸 포트
# (A/S 3000 · 통합 로그인 3100 · 회사 홈페이지 3200 · 계측기 3300 ·
#  시너지 출석부 3400 과 겹치지 않게)
PORT=3500

# 세션 쿠키(서명 토큰)의 서명 키. 32자 이상.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# 이 사이트의 세션은 서버에 저장되지 않는다 — 쿠키에 담긴 값 자체가 세션이고,
# 이 서명만이 그 값이 우리가 준 것임을 보증한다. 새어 나가면 누구나 아무
# 사람의 세션이나 만들어 낼 수 있다. SSO_TX_SECRET 과 **다른 값**을 쓴다.
# 값을 바꾸면 이미 나가 있는 세션이 전부 무효가 된다(모두 다시 로그인).
#
# 이름을 A/S 관리 시스템과 같게 맞췄다 — 두 사이트가 같은 방식(서명 토큰)으로
# 세션을 다루므로 이름도 같아야 옮겨 다니며 고칠 수 있다.
AUTH_SESSION_SECRET=

# 세션 쿠키에 secure 를 붙일지.
# 사내망 HTTP 단계에서 true 로 켜면 쿠키가 저장되지 않아 로그인이 조용히 실패한다.
# HTTPS 를 붙인 뒤에 true 로 바꾼다.
SESSION_COOKIE_SECURE=false

# 세션 수명(시간). dss-auth SSO 세션의 절대 만료 12시간을 넘기지 않는다.
SESSION_HOURS=12

# ------------------------------------------------------------------
# DSS 통합 로그인 (dss-auth 포털)
#
# 이 사이트는 자체 로그인을 만들지 않는다. 포털이 신원을 확인하고,
# 여기서는 그 결과(ID 토큰)만 검증해 자기 세션을 발급한다.
#
# 이름을 SSO_ 로 맞춘 이유: A/S 관리 시스템과 계측기 시스템도 같은 이름을
# 쓴다. Wi-Fi 가 바뀌어 IP 가 달라지면 세 시스템을 같은 방식으로 고친다.
# ------------------------------------------------------------------

# 포털 주소. ID 토큰의 iss 와 문자 단위로 같아야 한다. 끝에 / 를 붙이지 않는다.
# auto 면 실행할 때 이 기계의 사내망 주소 + 3100 으로 푼다.
SSO_ISSUER=auto

# 포털에 등록된 이 시스템의 식별자
SSO_CLIENT_ID=dss-improvements

# 포털에서 발급받은 시크릿. 발급 시 한 번만 표시된다.
# NEXT_PUBLIC_ 접두사를 붙이지 않는다 — 브라우저로 새어나간다.
SSO_CLIENT_SECRET=

# 포털이 로그인 결과를 돌려보낼 주소.
# 포털에 등록한 값과 문자 단위로 같아야 한다. 요청에서 만들어 쓰지 않는다 —
# LAN 접속에서 실제와 다른 값이 나오는 사례가 A/S 시스템에서 실측되었다.
# auto 면 실행할 때 이 기계의 사내망 주소 + PORT + /api/auth/sso/callback 으로 푼다.
SSO_REDIRECT_URI=auto

# 로그인 왕복 동안 state·nonce·PKCE 검증값을 나르는 쿠키의 서명 키. 32자 이상.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SSO_TX_SECRET=

# ─────────────────────────────────────────────────────────────────────
# 첨부 파일 저장 루트
# ─────────────────────────────────────────────────────────────────────
# 개선요청에 붙는 스크린샷의 **바이트가 놓이는 곳**이다. DB 에는 이 루트 기준
# 상대 경로만 적힌다(src/lib/db/schema.ts 의 stored_path 주석) — 그래서 NAS 로
# 옮기는 일이 「파일을 복사하고 이 한 줄을 바꾸는 일」이 된다.
#
# 🔴 값이 없으면 올리기가 **던진다.** 조용한 기본값(./uploads)을 두지 않는 것은,
#    그러면 파일이 어디로 갔는지 아무도 모르는 채 한동안 잘 돌아가다가 배포 뒤에야
#    「그때 올린 파일이 없다」로 발견되기 때문이다.
#
# 구분자는 `/` 로 적는다 — Windows 도 받아 주고, 역슬래시는 .env 를 읽는 쪽마다
# 이스케이프 규칙이 달라 조용히 한 겹 삼켜진다.
# 운영(NAS Docker)에서는 컨테이너 안의 마운트 지점(예: /data/uploads)을 적는다.
UPLOADS_DIR=C:/DSS-IMPROVEMENTS-DATA/uploads
