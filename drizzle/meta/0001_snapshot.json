      "checkConstraints": {
        "improvement_requests_body_length": {
          "name": "improvement_requests_body_length",
          "value": "char_length(\"improvement_requests\".\"body\") BETWEEN 1 AND 2000"
        },
        "improvement_requests_status_columns": {
          "name": "improvement_requests_status_columns",
          "value": "\n        (\"improvement_requests\".\"status\" = 'OPEN' AND \"improvement_requests\".\"in_progress_at\" IS NULL AND \"improvement_requests\".\"resolved_at\" IS NULL)\n        OR\n        (\"improvement_requests\".\"status\" = 'IN_PROGRESS' AND \"improvement_requests\".\"in_progress_at\" IS NOT NULL AND \"improvement_requests\".\"resolved_at\" IS NULL)\n        OR\n        (\"improvement_requests\".\"status\" = 'RESOLVED' AND \"improvement_requests\".\"resolved_at\" IS NOT NULL)\n      "
        },
        "improvement_requests_actor_pairs": {
          "name": "improvement_requests_actor_pairs",
          "value": "\n        (\"improvement_requests\".\"in_progress_by\" IS NULL OR \"improvement_requests\".\"in_progress_at\" IS NOT NULL)\n        AND (\"improvement_requests\".\"resolved_by\" IS NULL OR \"improvement_requests\".\"resolved_at\" IS NOT NULL)\n      "
        },
        "improvement_requests_origin": {
          "name": "improvement_requests_origin",
          "value": "\n        (\"improvement_requests\".\"imported_from\" IS NULL AND \"improvement_requests\".\"imported_ref\" IS NULL\n          AND \"improvement_requests\".\"imported_author_name\" IS NULL AND \"improvement_requests\".\"created_by\" IS NOT NULL)\n        OR\n        (\"improvement_requests\".\"imported_from\" IS NOT NULL AND \"improvement_requests\".\"imported_ref\" IS NOT NULL\n          AND (\"improvement_requests\".\"created_by\" IS NOT NULL OR \"improvement_requests\".\"imported_author_name\" IS NOT NULL))\n      "
